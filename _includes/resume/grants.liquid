<ul class="card-text font-weight-light list-group list-group-flush">
  {% assign grants = data[1] | sort: 'startDate' | reverse %}
  {% for content in grants %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-2 cl-sm-2 col-md-2 text-center date-column">
          {% if content.startDate %}
            {% assign startDate = content.startDate | split: '-' | slice: 0, 2 | join: '.' %}
            {% assign endDate = content.endDate | split: '-' | slice: 0, 2 | join: '.' | default: 'Present' %}
            {% assign date = startDate | append: ' - ' | append: endDate %}
          {% else %}
            {% assign date = '' %}
          {% endif %}
          <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px"> {{ date }} </span>
        </div>
        <div class="col-xs-10 cl-sm-10 col-md-10 mt-2 mt-md-0">
          <h6 class="title font-weight-bold ml-1 ml-md-4">
            {% if content.url %}
              <a href="{{ content.url }}">{{ content.title }}</a>
            {% else %}
              {{ content.title }}
            {% endif %}
          </h6>
          {% if content.grantor %}
            <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem; font-style: italic">{{ content.grantor }}</h6>
          {% endif %}
          {% assign has_details = false %}
          {% if content.grantNumber %}
            {% assign has_details = true %}
          {% endif %}
          {% if content.summary %}
            {% assign has_details = true %}
          {% endif %}
          {% if content.highlights and content.highlights.size > 0 %}
            {% assign has_details = true %}
          {% endif %}
          {% if has_details %}
            <ul class="items">
              {% if content.grantNumber %}
                <li>
                  <span class="item">Grant number: {{ content.grantNumber }}</span>
                </li>
              {% endif %}
              {% if content.summary %}
                <li>
                  <span class="item">{{ content.summary }}</span>
                </li>
              {% endif %}
              {% for item in content.highlights %}
                <li>
                  <span class="item">{{ item }}</span>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
