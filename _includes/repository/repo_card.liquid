{% comment %}
  One repository card. Everything readable is rendered at build time; the meta
  row (language, stars, forks, last updated) is filled in by repositories.md's
  script from a single GitHub API call per owner, and stays hidden if that call
  does not happen.
{% endcomment %}

{% if include.entry.repo %}
  {% assign slug = include.entry.repo %}
  {% assign note = include.entry.note %}
  {% assign paper = include.entry.paper %}
  {% assign label = include.entry.name %}
{% else %}
  {% assign slug = include.entry %}
{% endif %}
{% assign parts = slug | split: '/' %}
{% unless label %}
  {% assign label = parts[1] %}
{% endunless %}

<li class="ac-repo" data-repo="{{ slug }}">
  <div class="ac-repo-head">
    <a class="ac-repo-link" href="https://github.com/{{ slug }}" rel="noopener" title="{{ slug }}">
      <span class="ac-repo-owner">{{ parts[0] }}&#8202;/&#8202;</span><span class="ac-repo-name">{{ label }}</span>
    </a>
    {% if paper %}
      <span class="ac-repo-paper">{{ paper }}</span>
    {% endif %}
  </div>

  <p class="ac-repo-note" data-note>{{ note }}</p>

  <div class="ac-repo-meta" data-meta hidden>
    <span class="ac-repo-lang" data-lang hidden>
      <i class="ac-repo-dot" data-dot></i><span data-lang-name></span>
    </span>
    <span class="ac-repo-stat" data-stars hidden>
      <svg class="ac-repo-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"/></svg><span data-stars-value></span><span class="sr-only"> stars</span>
    </span>
    <span class="ac-repo-stat" data-forks hidden>
      <svg class="ac-repo-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path fill="currentColor" d="M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75v-.878a2.25 2.25 0 1 1 1.5 0v.878a2.25 2.25 0 0 1-2.25 2.25h-1.5v2.128a2.251 2.251 0 1 1-1.5 0V8.5h-1.5A2.25 2.25 0 0 1 3.5 6.25v-.878a2.25 2.25 0 1 1 1.5 0ZM5 3.25a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Zm6.75.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm-3 8.75a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Z"/></svg><span data-forks-value></span><span class="sr-only"> forks</span>
    </span>
    <span class="ac-repo-stat ac-repo-updated" data-updated hidden></span>
  </div>
</li>
